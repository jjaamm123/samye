# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "development" locally. On Render/Vercel/Heroku set to "production".
# The seeder will REFUSE to run if this is set to "production".
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Your MongoDB Atlas connection string (or local URI for dev).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/samye?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
