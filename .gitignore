# ─── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ─── Environment Variables (ALL .env files — never commit secrets) ─────────────
# This wildcard catches root, backend, and frontend .env files.
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Explicitly allow the example template so teammates can onboard safely
!.env.example
!backend/.env.example
!frontend/.env.example

# ─── Build Artifacts ───────────────────────────────────────────────────────────
frontend/dist/
frontend/build/
.vite/

# ─── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ──────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
resetAdmin.js
backend/resetAdmin.js